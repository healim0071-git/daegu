<!-- ======================================================================= -->
<!-- healim-panic.com 1:1 일치 공통 바텀 영역 (Publications ~ Network Banner)    -->
<!-- 내용: 해아림한의원 대구본점 커뮤니티 (FAQ, 치료후기, 유튜브, 치료칼럼) 실시간 연동 -->
<!-- ======================================================================= -->
<div class="healim-bottom-section-wrapper" style="margin-top: 60px;">

  <!-- ── 1. Publications: 해아림 원장단 임상 노하우 도서 출간 ── -->
  <section class="healim-bottom-section">
    <div class="bottom-sec-header">
      <span class="bottom-sec-badge">Publications</span>
      <h2 class="healim-section-title">해아림 원장단 임상 노하우 도서 출간</h2>
      <p class="healim-section-subtitle">16여 년 임상 노하우와 뇌신경계 조절 메커니즘을 알기 쉽게 풀어낸 해아림의 대표 저서입니다.</p>
    </div>

    <div class="books-grid">
      <!-- 도서 1: 토닥토닥 틱장애 -->
      <div class="book-card">
        <a href="https://product.kyobobook.co.kr/detail/S000001851814" target="_blank" rel="noopener noreferrer" class="book-cover-link">
          <div class="book-cover-wrapper">
            <img src="/images/books/book_tic.png" alt="토닥토닥 틱장애 (해아림 원장단 공저)" loading="lazy">
            <span class="book-click-badge">CLICK &gt;</span>
          </div>
        </a>
        <h3 class="book-title">『토닥토닥 틱장애』</h3>
        <p class="book-desc">
          해아림 원장단 공저 · 틱장애와 뇌신경 질환의 통합 치료 노하우를 집대성한 필독서
        </p>
        <a href="https://product.kyobobook.co.kr/detail/S000001851814" target="_blank" rel="noopener noreferrer" class="btn-book-kyobo">
          <span>교보문고 바로가기 &gt;</span>
        </a>
      </div>

      <!-- 도서 2: 걱정마 공황장애 -->
      <div class="book-card">
        <a href="https://product.kyobobook.co.kr/detail/S000212414668" target="_blank" rel="noopener noreferrer" class="book-cover-link">
          <div class="book-cover-wrapper">
            <img src="/images/books/book_panic.png" alt="걱정마 공황장애 (해아림 원장단 공저)" loading="lazy">
            <span class="book-click-badge">CLICK &gt;</span>
          </div>
        </a>
        <h3 class="book-title">『걱정마 공황장애』</h3>
        <p class="book-desc">
          해아림 원장단 공저 · 가슴 두근거림, 호흡곤란, 자율신경계 과흥분을 다스리는 신경정신과 임상 치유 가이드
        </p>
        <a href="https://product.kyobobook.co.kr/detail/S000212414668" target="_blank" rel="noopener noreferrer" class="btn-book-kyobo">
          <span>교보문고 바로가기 &gt;</span>
        </a>
      </div>
    </div>

    <!-- 하단 오렌지색 슬로건 바 -->
    <div class="publications-bottom-banner">
      <p>📚 전국 16개 네트워크 해아림한의원 원장단의 16년 임상 노하우 집약 도서</p>
    </div>
  </section>


  <!-- ── 2. FAQ Insights: 해아림한의원 자주 묻는 질문들 FAQ ── -->
  <section class="healim-bottom-section">
    <div class="bottom-sec-header">
      <span class="bottom-sec-badge">FAQ Insights</span>
      <h2 class="healim-section-title">해아림한의원 자주 묻는 질문들 FAQ</h2>
      <p class="healim-section-subtitle">환자분들이 가장 많이 궁금해하시는 핵심 질문에 원장단이 명쾌하게 답변해 드립니다.</p>
    </div>

    <div id="commonBottomFaqList" class="bottom-faq-container">
      {{ $slug := strings.Trim .RelPermalink "/" }}
      {{ $diseaseFaqs := index site.Data.disease_faqs $slug }}
      {{ if not $diseaseFaqs }}
        {{ $diseaseFaqs = index site.Data.disease_faqs (path.Base .RelPermalink) }}
      {{ end }}
      {{ if $diseaseFaqs }}
        {{/* 10개 질환 페이지: 해당 질환에 정확히 일치하는 핵심 FAQ 4개 렌더링 */}}
        {{ range $diseaseFaqs }}
        <details class="faq-item">
          <summary>
            <span class="faq-summary-left">
              <span class="faq-q-badge">Q.</span>
              <span class="faq-tag-badge">{{ .tag }}</span>
              <span class="faq-q-text">{{ .q }}</span>
            </span>
          </summary>
          <div class="faq-answer">
            <div class="faq-content-body">
              {{ .a | safeHTML }}<br><br>
              {{ if .link }}
              <a href="{{ .link }}"><span>{{ .linkText }}</span> <span>&gt;</span></a>
              {{ end }}
            </div>
          </div>
        </details>
        {{ end }}
      {{ else }}
        <!-- 메인 페이지 및 일반 페이지 기본 FAQ 5개 렌더링 -->
        <!-- 초기 정적 렌더링 (동적 스크립트에 의해 자동 갱신됨) -->
      <details class="faq-item">
        <summary>
          <span class="faq-summary-left">
            <span class="faq-q-badge">Q.</span>
            <span class="faq-tag-badge">틱장애</span>
            <span class="faq-q-text">초등학생 자녀의 틱 증상이 비염이나 알레르기 결막염과 겹칠 때는 어떻게 구분하나요?</span>
          </span>
        </summary>
        <div class="faq-answer">
          <div class="faq-content-body">
            학령기 아동에서 틱 증상과 알레르기 질환은 겉으로 보기에 유사하지만 신경학적 발생 기전에는 명확한 차이가 있습니다. 비염이나 결막염 환아는 코점막의 충혈이나 안구 결막의 소양감, 통증 등 국소 부위의 물리적 불편함을 직접 호소하며, 항히스타민제나 안약 등 알레르기 약물을 투여하면 가려움과 함께 깜빡임이 즉각 완화됩니다.<br><br>
            반면 틱 증상은 물리적 가려움보다는 눈이나 목 안쪽이 답답하고 찝찝하여 움직이지 않고는 견디기 힘든 불수의적 신경 충동(전조 감각 충동, Premonitory Urge)에 의해 무의식적으로 행해집니다. 또한 학습 스트레스, 피로, 긴장 상황이나 반대로 긴장이 풀리는 저녁 시간대에 증상 빈도가 급증하는 신경학적 변동성을 보입니다.<br><br>
            해아림한의원 대구본점에서는 풍담(風痰)이 뇌신경계로 상충하여 기저핵-시상 회로의 운동 여과 기능이 저하된 것으로 변증하며, 신경 과각성을 가라앉히는 소아 맞춤 한약과 두경부 근막 이완 치료를 적용합니다.<br><br>
            <a href="/tic-disorder/"><span>틱장애 정밀클리닉 알아보기</span> <span>&gt;</span></a>
          </div>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-summary-left">
            <span class="faq-q-badge">Q.</span>
            <span class="faq-tag-badge">공황장애</span>
            <span class="faq-q-text">가만히 쉬고 있을 때도 갑자기 심장이 터질 듯 뛰고 숨이 막힙니다. 응급실 검사는 정상인데 정말 공황장애인가요?</span>
          </span>
        </summary>
        <div class="faq-answer">
          <div class="faq-content-body">
            심장내과나 응급실 검사상 정상 판정을 받는 이유는 심장이나 폐의 기질적 파괴가 아니라, 뇌 편도체의 오작동으로 자율신경계에 비상 사이렌이 울린 '기능적 교감신경 폭풍'이기 때문입니다.<br><br>
            교감신경이 급격히 항진되면 심장이 분당 130회 이상 뛰고 과호흡으로 인해 가슴 통증과 질식감이 발생하지만, 이는 위험한 심장마비가 아니므로 안심하셔도 좋습니다. 4-6 구순 복식호흡과 5-4-3-2-1 감각 그라운딩을 시행하면 10~15분 내로 뇌간 경보가 진정됩니다.<br><br>
            해아림한의원 대구본점에서는 뇌파(QEEG) 및 HRV 자율신경 검사로 신경계 불균형을 정밀 진단하고, 청심온담탕 가감 처방과 두개천골요법(CST)으로 편도체 과열을 정상화합니다.<br><br>
            <a href="/panic-disorder/"><span>공황장애 정밀클리닉 알아보기</span> <span>&gt;</span></a>
          </div>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-summary-left">
            <span class="faq-q-badge">Q.</span>
            <span class="faq-tag-badge">불면증</span>
            <span class="faq-q-text">잠들기 힘들고 자다 깨면 다시 잠 못 드는 만성 불면증, 수면제 없이 치료 가능한가요?</span>
          </span>
        </summary>
        <div class="faq-answer">
          <div class="faq-content-body">
            수면제나 수면유도제는 뇌 중추를 인위적으로 마비시키는 방식으로, 장기 복용 시 약물 내성과 낮 시간대 몽롱함, 의존성이 발생하기 쉽습니다.<br><br>
            한의학에서는 뇌의 상열감(上熱感)과 심장의 화(火)를 식히고 하초의 기운을 보강하는 수승화강(水昇火降) 원리를 통해 뇌파가 자연스럽게 수면 델타파로 유도되도록 돕습니다. 산조인탕, 귀비탕 맞춤 한약과 이완 훈련으로 수면제 없이도 스스로 깊은 잠에 드는 뇌 자생력을 되찾아 드립니다.<br><br>
            <a href="/insomnia/"><span>수면장애·불면증 클리닉 알아보기</span> <span>&gt;</span></a>
          </div>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-summary-left">
            <span class="faq-q-badge">Q.</span>
            <span class="faq-tag-badge">자율신경</span>
            <span class="faq-q-text">병원 검사상 아무 이상이 없다는데 어지럼증과 가슴 두근거림, 소화불량이 지속됩니다. 자율신경실조증인가요?</span>
          </span>
        </summary>
        <div class="faq-answer">
          <div class="faq-content-body">
            내과, 신경과, 이비인후과 등에서 CT나 혈액 검사를 받아도 '이상 없음'이 나오는데 두통, 기립성 어지럼, 위장 무력, 식은땀이 반복된다면 뇌-자율신경계 조절 시스템 이상인 자율신경실조증(Dysautonomia)일 가능성이 매우 높습니다.<br><br>
            교감신경과 부교감신경의 시소 균형이 깨지면 혈관 수축과 내장 평활근 조절 기능이 떨어져 전신 증상이 동시다발적으로 나타납니다. 해아림한의원 대구본점에서는 HRV 정밀 검사와 경추-두개골 이완, 뇌신경계 순환 한약으로 무너진 자율신경 리듬을 회복시킵니다.<br><br>
            <a href="/dysautonomia/"><span>자율신경실조증 클리닉 알아보기</span> <span>&gt;</span></a>
          </div>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-summary-left">
            <span class="faq-q-badge">Q.</span>
            <span class="faq-tag-badge">소아ADHD</span>
            <span class="faq-q-text">산만하고 충동적인 초등학생 우리 아이, 소아 ADHD인가요 단순한 성향 차이인가요?</span>
          </span>
        </summary>
        <div class="faq-answer">
          <div class="faq-content-body">
            단순히 활발한 성향과 주의력결핍 과잉행동장애(ADHD)의 결정적 차이는 '상황에 맞춘 자기 통제(Self-Regulation) 능력의 유무'입니다. 좋아하는 놀이에는 몰입하지만 수업 시간 착석, 과제 수행, 차례 지키기 등 규칙이 있는 상황에서 주의 집중을 10분 이상 유지하기 힘들다면 전두엽 억제 회로의 미성숙을 점검해야 합니다.<br><br>
            해아림한의원 대구본점에서는 전두엽과 기저핵의 도파민·노르에피네프린 신경망 활성화를 돕는 소아 맞춤 한약과 감각통합 훈련을 통해 충동성을 완화하고 주의 집중 지속 시간을 안정적으로 늘려줍니다.<br><br>
            <a href="/adhd/"><span>소아·청소년 ADHD 클리닉 알아보기</span> <span>&gt;</span></a>
          </div>
        </div>
      </details>
      {{ end }}
    </div>

    <div class="bottom-btn-center">
      <a href="/community/#faq" onclick="handleBottomMoreClick(event, 'faq')" class="btn-healim">
        <span>자주 묻는 질문 FAQ 더보기 &gt;</span>
      </a>
    </div>
  </section>


  <!-- ── 3. Patient Stories: 해아림한의원 치료후기 (B 스타일 적용) ── -->
  <section class="healim-bottom-section">
    <div class="bottom-sec-header">
      <span class="bottom-sec-badge">Patient Stories</span>
      <h2 class="healim-section-title">해아림한의원 치료후기</h2>
      <p class="healim-section-subtitle">환자분들의 진솔한 실제 치료 경험과 일상 회복의 순간들입니다. (의료법 제56조 준수 환자 보호 블러 처리)</p>
    </div>

    <div id="commonBottomReviewsList" class="bottom-cards-grid">
      <!-- 1 -->
      <a href="https://www.healim.com/5-3" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit; display: block;">
        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 18px; box-shadow: 0 4px 14px rgba(0,0,0,0.02); height: 100%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.2s ease;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='#008194'; this.style.boxShadow='0 8px 24px rgba(0,129,148,0.12)';" onmouseout="this.style.transform='none'; this.style.borderColor='#E2E8F0'; this.style.boxShadow='0 4px 14px rgba(0,0,0,0.02)';">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span style="font-size: 11.5px; font-weight: 700; color: #008194; background: #E6F6F8; padding: 3px 8px; border-radius: 4px;">우울증</span>
              <span style="font-size: 12px; color: #94A3B8;">2026-09-23 · 조회 2</span>
            </div>
            <div style="display: flex; gap: 14px; margin-bottom: 12px; align-items: flex-start;">
              <div style="width: 86px; height: 86px; flex-shrink: 0; border-radius: 8px; overflow: hidden; position: relative; background: #F8FAFB; border: 1px solid #E2E8F0;">
                <img src="/images/reviews/review_1.jpg" alt="자필 치료후기" style="width: 100%; height: 100%; object-fit: cover; filter: blur(4.5px); -webkit-filter: blur(4.5px); transform: scale(1.15);" loading="lazy" />
                <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.08); display: flex; align-items: center; justify-content: center;">
                  <span style="font-size: 10px; background: rgba(12,67,73,0.85); color: #FFF; padding: 2px 5px; border-radius: 3px; font-weight: 700;">자필보호</span>
                </div>
              </div>
              <div style="flex: 1; min-width: 0;">
                <h4 style="font-size: 14.5px; font-weight: 800; color: #0C4349; margin: 0 0 6px; line-height: 1.45; word-break: keep-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">우울증 후기 - 의욕과 활력이 생겼어요. 혼자서 힘들어하지 말고 꼭...</h4>
                <p style="font-size: 12.5px; color: #64748B; line-height: 1.6; margin: 0; word-break: keep-all; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">1. 치료 받기 전 증상들로 인해 얼마나 힘들었는지 구체적으로 적어 주세요. a. 기분이 많이 가라앉았...</p>
              </div>
            </div>
          </div>
          <div style="padding-top: 10px; border-top: 1px dashed #E2E8F0; display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: #146369; font-weight: 700;">
            <span>본원 후기 원문 보기 ↗</span>
            <span style="color: #94A3B8; font-weight: 400; font-size: 11.5px;">healim.com/5-3</span>
          </div>
        </div>
      </a>

      <!-- 2 -->
      <a href="https://www.healim.com/5-3" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit; display: block;">
        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 18px; box-shadow: 0 4px 14px rgba(0,0,0,0.02); height: 100%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.2s ease;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='#008194'; this.style.boxShadow='0 8px 24px rgba(0,129,148,0.12)';" onmouseout="this.style.transform='none'; this.style.borderColor='#E2E8F0'; this.style.boxShadow='0 4px 14px rgba(0,0,0,0.02)';">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
