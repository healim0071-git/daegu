<!-- ── 공통 바텀 커뮤니티 데이터 실시간 연동 및 모달 제어 스크립트 ── -->
<script>
(function() {
  // 기본 데이터셋 (Daegu Community)
  var defaultBottomFaqs = [{"id": "faq-auto-tic-1", "disease": "틱장애", "date": "2026.09.28", "q": "초등학생 자녀의 틱 증상이 비염이나 알레르기 결막염과 겹칠 때는 어떻게 구분하나요?", "a": "학령기 아동에서 틱 증상과 알레르기 질환은 겉으로 보기에 유사하지만 신경학적 발생 기전에는 명확한 차이가 있습니다. 비염이나 결막염 환아는 코점막의 충혈이나 안구 결막의 소양감, 통증 등 국소 부위의 물리적 불편함을 직접 호소하며, 항히스타민제나 안약 등 알레르기 약물을 투여하면 가려움과 함께 깜빡임이 즉각 완화됩니다.\n\n반면 틱 증상은 물리적 가려움보다는 눈이나 목 안쪽이 답답하고 찝찝하여 움직이지 않고는 견디기 힘든 불수의적 신경 충동(전조 감각 충동, Premonitory Urge)에 의해 무의식적으로 행해집니다. 또한 학습 스트레스, 피로, 긴장 상황이나 반대로 긴장이 풀리는 저녁 시간대에 증상 빈도가 급증하는 신경학적 변동성을 보입니다.\n\n한의학에서는 풍담(風痰)이 뇌신경계로 상충하여 기저핵-시상 회로의 운동 여과 기능이 저하된 것으로 변증하며, 신경 과각성을 가라앉히는 소아 맞춤 한약과 두경부 근막 이완 치료를 적용합니다."}, {"id": "faq-auto-tic-2", "disease": "틱장애", "date": "2026.09.27", "q": "음성 틱(음음, 킁킁) 소리를 아이에게 참으라고 주의를 주면 왜 더 심해지나요?", "a": "음성 틱은 단순한 나쁜 버릇이 아니라 뇌 기저핵의 신호 억제 회로가 불필요한 발성 신호를 걸러내지 못해 발생하는 불수의적 신경학적 증상입니다. 아이에게 소리를 내지 말라고 다그치거나 참으라고 지적하면, 아이는 틱 동작을 억누르기 위해 전두엽에 과도한 인지적 억제 에너지를 소모하게 됩니다.\n\n이러한 강제적 억압은 뇌 내부의 감각-운동 신경 긴장도를 급격히 상승시켜 전조 감각 충동을 폭발적으로 증폭시킵니다. 그 결과 일시적으로 소리를 멈춘 뒤 긴장이 풀리는 순간 억눌렸던 신호가 한꺼번에 터져 나오는 '반동 현상(Rebound Effect)'이 발생하여 오히려 음성 틱의 빈도와 강도가 배가됩니다.\n\n따라서 가정에서는 증상을 지적하지 않는 '무관심의 원칙'을 철저히 지키는 한편, 뇌신경의 흥분을 안정시키고 기저핵 억제력을 회복시키는 체계적인 한방 진료를 병행하는 것이 바람직합니다."}, {"id": "faq-auto-tic-3", "disease": "틱장애", "date": "2026.09.26", "q": "단순 운동 틱(눈 깜빡임)에서 복합 운동 틱(목 꺾기, 팔 털기)으로 번지는 징후는 무엇인가요?", "a": "틱장애는 통상 얼굴 중심부의 단순 근육(눈 깜빡임, 코 찡긋거림)에서 시작하여 점차 목, 어깨, 체간, 사지 말단으로 진행하는 하행성(Cephalo-caudal) 진행 패턴을 보입니다. 눈 깜빡임 빈도가 잦아지면서 목을 뒤로 젖히거나 어깨를 으쓱거리는 동작이 복합된다면 대뇌 기저핵-피질 운동 회로의 흥분 신호가 주변 운동 영역으로 확산되고 있음을 시사합니다.\n\n특히 새로운 신체 부위로 틱 동작이 전이되거나 하루에도 수십 회 이상 연속적으로 발생하고, 특정 동작을 취하지 않으면 극심한 불쾌감을 느낀다면 만성화 및 복합 틱 단계로의 이행 신호로 간주해야 합니다.\n\n한의학에서는 간풍내동(肝風內動)의 진행 단계로 파악하여 흥분된 도파민 신경망의 균형을 되찾고 척추 신경망의 긴장을 이완시키는 침구 및 체질 한약 치료로 신경계 전이 차단을 유도합니다."}, {"id": "faq-auto-tic-4", "disease": "틱장애", "date": "2026.09.25", "q": "소아 틱장애 치료 시 스마트폰이나 게임 시간을 엄격히 제한해야 하는 의학적 이유는 무엇인가요?", "a": "스마트폰, 태블릿 PC, 컴퓨터 게임 등은 초당 수십 프레임의 강렬한 시각적 자극과 빠른 보상 체계를 지니고 있어 미성숙한 소아 뇌의 측핵과 전두엽을 극도로 흥분시킵니다. 이 과정에서 도파민(Dopamine)이 비정상적으로 과다 분비되며, 도파민 수용체가 과각성되면 기저핵의 운동 억제 임계치가 급격히 낮아져 잠재되어 있던 틱 충동이 격렬하게 촉발됩니다.\n\n또한 전자기기를 장시간 몰입하여 시청하면 후두하근과 상부 경추가 경직되어 뇌간으로 이어지는 뇌혈류 흐름이 제한되며, 취침 전 블루라이트는 멜라토닌 생성을 방해해 뇌 피로 회복을 가로막습니다.\n\n따라서 틱 치료 기간에는 디지털 미디어 노출을 하루 30분 이내로 제한하고, 자연광 아래에서 원거리 시야를 확보하는 야외 신체 활동을 통해 시각-운동 신경계의 과부하를 해소해 주어야 합니다."}, {"id": "faq-auto-tic-5", "disease": "틱장애", "date": "2026.09.24", "q": "성인 틱장애는 소아 틱장애와 어떻게 다르며, 성인이 되어서도 호전이 가능한가요?", "a": "성인 틱장애는 어릴 때 발생했던 틱이 성인기까지 지속되었거나, 학업 및 직장 생활의 만성 스트레스와 수면 부족, 과로로 인해 재발한 경우가 대부분입니다. 소아 틱과 달리 성인 환자는 사회적 시선에 대한 극심한 불안, 자존감 저하, 우울증, 대인기피증 등 2차적인 정서 장애를 복합적으로 동반하는 경향이 뚜렷합니다.\n\n또한 이미 신경 가소성이 완성된 성인 뇌에서는 특정 신경회로의 과각성이 습관화되어 있으므로 단순 대증 치료보다는 교감신경의 만성 긴장을 풀고 자율신경계 밸런스를 조절하는 통합적 접근이 요구됩니다.\n\n한방에서는 뇌신경 스트레스를 다스리는 시호, 조구등 등의 청열 진경 한약과 두개안면부 긴장 완화 침 치료를 병행하여, 성인기 틱의 발동 역치를 높이고 일상생활에서의 사회적 적응력을 점진적으로 회복시킵니다."}];
  var defaultBottomReviews = [{"id": 1, "uid": "257", "disease": "우울증", "title": "우울증 후기 - 의욕과 활력이 생겼어요. 혼자서 힘들어하지 말고 꼭 치료받으세요.", "content": "1. 치료 받기 전 증상들로 인해 얼마나 힘들었는지 구체적으로 적어 주세요.\na. 기분이 많이 가라앉았...", "img": "https://www.healim.com/wp-content/uploads/kboard_attached/3/202609/6ab36d9b1fb358328084-130x130.jpg", "date": "2026-09-23", "views": "2", "targetUrl": "https://www.healim.com/5-3"}, {"id": 2, "uid": "256", "disease": "우울증", "title": "우울증 치료후기 - 살 수 있을 것 같아 좋아요.", "content": "1. 치료 받기 전 증상들로 인해 얼마나 힘들었는지 구체적으로 적어 주세요.\n처음은 자기자책과 죽고 ...", "img": "https://www.healim.com/wp-content/uploads/kboard_attached/3/202609/6ab364aeb849c6959504-130x130.jpg", "date": "2026-09-23", "views": "2", "targetUrl": "https://www.healim.com/5-3"}, {"id": 3, "uid": "255", "disease": "공황장애", "title": "공황장애 후기 -  호흡이 편안해지고, 나쁜 감정에서 빠져 나올 수 있어요.", "content": "치료 받기 전 증상들로 인해 얼마나 힘들었는지 구체적으로 적어 주세요.\n\na. 사람이 많은 공간, 폐...", "img": "https://www.healim.com/wp-content/uploads/kboard_attached/3/202609/6aa8e5cc5d4827332728-130x130.png", "date": "2026-09-15", "views": "5", "targetUrl": "https://www.healim.com/5-3"}, {"id": 4, "uid": "254", "disease": "강박증", "title": "강박증 치료 후기 - 반신반의했던 생각에서 탁월한 선택을 했다고 생각합니다.", "content": "1. 치료 받기 전 증상들로 인해 얼마나 힘들었는지 구체적으로 적어 주세요.\na. 강박 증상 (생각 등)이...", "img": "https://www.healim.com/wp-content/uploads/kboard_attached/3/202609/6aa8e6338d49d1165384-130x130.png", "date": "2026-09-14", "views": "4", "targetUrl": "https://www.healim.com/5-3"}, {"id": 5, "uid": "253", "disease": "틱장애", "title": "틱장애 치료후기 - 틱 개선 후 정서적으로 더 성장해온 것 같아요.", "content": "처음 제 아이가 틱장애라는 의심하게 되었을 무렵 여러 한의원을 알아봤고 그중에 해아림한의원을 알...", "img": "https://www.healim.com/wp-content/uploads/kboard_attached/3/202609/6aa3c422a54dc3060837-130x130.jpg", "date": "2026-09-11", "views": "6", "targetUrl": "https://www.healim.com/5-3"}, {"id": 6, "uid": "252", "disease": "틱장애", "title": "틱장애 치료후기 - 아이를 걱정스럽게 바라보지 않게 되어서 좋습니다.", "content": "의사 선생님이 환자 및 보호자의 마음을 편하게 해주십니다. 꾸준히 치료 받으면 좋은 결과가 있으...", "img": "https://www.healim.com/wp-content/uploads/kboard_attached/3/202609/6aa3c3a630a6e3110775-130x130.jpg", "date": "2026-09-11", "views": "3", "targetUrl": "https://www.healim.com/5-3"}];
  var defaultBottomColumns = [{"id": "col-auto-tic-1", "category": "틱장애", "title": "[소아 틱장애 초기증상] 눈 깜빡임과 헛기침 반복될 때 기저핵 억제 회로 불균형과 조기 진료 가이드", "author": "해아림한의원", "date": "2026.09.28", "views": 121, "summary": "아이들의 눈 깜빡임, 코 찡긋거림, 헛기침 등 소아 틱장애 초기증상의 신경학적 원인인 대뇌피질-기저핵 운동 억제 회로 불균형을 분석하고 한의학적 진단과 가정 내 대처 가이드를 제시합니다.", "content": "소아 틱장애(Tic Disorder)는 자신의 의지와 무관하게 눈을 깜빡이거나 코를 찡긋거리고, 헛기침이나 음음 소리를 반복하는 신경학적 질환입니다. 이는 대뇌피질과 기저핵(Basal Ganglia), 시상을 연결하는 피질-선조체-시상 회로(CSTC)의 운동 억제 조절 기능이 일시적으로 불균형을 겪으며 발생합니다. 아이에게 증상을 지적하거나 참도록 강요하면 불안과 스트레스로 인해 증상이 더욱 악화될 수 있으므로, 초기부터 전문적인 신경학적 평가와 한의학적 심신 안정 치료를 병행하는 것이 바람직합니다.\n\n[환자들이 자주 묻는 질문과 임상 증상]\n\"아이가 갑자기 눈을 심하게 깜빡이고 킁킁거리는 소리를 내는데 단순한 버릇이나 비염일까요?\" 진료실에서 학부모님들이 가장 흔히 묻는 질문입니다. 틱장애는 크게 근육을 움직이는 운동 틱(눈 깜빡임, 고개 흔들기, 어깨 들썩이기 등)과 소리를 내는 음성 틱(헛기침, 코 훌쩍임, 신음소리 등)으로 나뉩니다. 초기에는 결막염이나 알레르기 비염으로 오인하기 쉬우나, 안과나 이비인후과 치료 후에도 증상이 지속되거나 형태를 바꾸어 나타난다면 신경학적 틱 증상을 의심해야 합니다. 틱 증상의 가장 큰 특징은 증상이 나타나기 전 목이나 눈 주위가 답답하고 찜찜하여 참기 힘든 느낌인 '전조 감각 충동(Premonitory Urge)'이 동반된다는 점입니다.\n\n[신경해부학적 발병 메커니즘과 신경전달물질]\n뇌신경학적으로 틱장애는 뇌의 운동 조절 중추인 기저핵의 여과 기능 약화와 밀접합니다. 기저핵은 대뇌피질에서 발생하는 수많은 운동 신호 중 불필요한 신호를 억제하고 꼭 필요한 동작만을 부드럽게 출력하도록 걸러주는 필터 역할을 담당합니다. 그러나 신경 발달 과정에서 억제성 신경전달물질인 GABA와 흥분성 신경전달물질인 도파민(Dopamine) 수용체 간의 균형이 무너지면, 불필요한 운동 신호가 억제되지 못하고 신체 근육군으로 새어나가 불수의적인 틱 증상으로 발현됩니다. 특히 만 5~7세 전후 뇌신경계 발달 시기에 과도한 학업 스트레스, 스마트폰의 시각적 과자극, 낯선 환경에의 노출 등이 겹치면 전두엽의 기능적 피로가 가중되어 증상이 두드러지게 됩니다.\n\n[한의학적 원인 분석과 변증별 진료 방향]\n한의학에서는 소아 틱장애를 오장육부 중 간(肝)과 심(心)의 불균형으로 파악합니다. 간은 인체의 근육 운동과 소설(疏泄, 기운의 소통)을 주관하고, 심은 정신과 정서(神明)를 주관합니다. 스트레스나 긴장으로 간의 기운이 뭉치고 열이 발생하면 간풍내동(肝風內動)의 병리가 형성되어 근육이 파르르 떨리고 눈이 깜빡이는 운동 틱이 나타납니다. 반면 소심하고 예민하여 사소한 자극에도 쉽게 놀라는 아이는 심담허겁(心膽虛怯)으로 분류하여 심장과 담의 기운을 보강하고 담음을 제거하는 온담탕(溫膽湯) 계열 처방을 응용합니다. 체질에 부합하는 한약은 과열된 대뇌 신경망의 흥분을 가라앉히고 기저핵의 자율적 억제 능력을 회복시키는 데 기여합니다.\n\n[체계적인 치료 단계 및 생활 속 자가 관리 가이드]\n1단계: 틱 증상에 대한 '무관심의 원칙' 유지하기. 부모가 아이의 증상을 지적하거나 눈치를 주면 아이는 과도한 긴장 상태에 빠져 틱 억제 후 반동 현상(Rebound Effect)으로 증상이 더욱 심해집니다.\n2단계: 시각적 흥분을 유발하는 디지털 기기 노출 차단."}, {"id": "col-auto-tic-2", "category": "틱장애", "title": "[음성 틱과 복합 틱] 기저핵 도파민 과민 반응과 신경망 안정 한의학적 치료 전략", "author": "해아림한의원", "date": "2026.09.27", "views": 124, "summary": "단순 운동 틱을 넘어 '음음', '악' 소리를 내거나 욕설, 단어를 반복하는 음성 틱 및 복합 틱의 신경생리학적 원인과 도파민 수용체 조절, 신경망 안정을 위한 한의학적 치료 원리를 상세히 설명합니다.", "content": "음성 틱(Vocal Tic)은 성대나 비강, 구강 근육의 불수의적인 수축으로 인해 특정 소리나 단어, 문장을 반복해서 발성하는 증상입니다. 운동 틱이 나타난 후 수개월 혹은 수년 뒤 음성 틱이 결합되는 경우가 흔하며, 이는 뇌간과 변연계, 기저핵을 잇는 도파민성 신경망의 과민도가 심화되었음을 시사합니다. 단순 습관성 기침으로 방치할 경우 사회적 위축과 교우 관계 단절로 이어질 수 있으므로, 뇌신경계의 과도한 흥분을 조절하고 자율신경 균형을 바로잡는 조기 복합 치료가 요구됩니다.\n\n[환자들이 자주 묻는 질문과 임상 증상]\n\"처음에는 눈만 깜빡이더니 이제는 '음음', '악악' 소리를 내거나 본인 말을 메아리처럼 반복해요.\" 이처럼 운동 틱에서 음성 틱으로 증상이 전이되거나 동시에 출현할 때 보호자들의 심리적 불안은 극에 달합니다. 단순 음성 틱은 헛기침, 끙끙거림, 코 훌쩍임 등의 소리를 내는 것이며, 증상이 복합화되면 상황에 맞지 않는 특정 단어를 말하거나 반향어(남의 말을 따라함), 외설증(욕설을 내뱉음) 형태로 발전할 수 있습니다. 환아 본인도 교실이나 공공장소에서 소리를 참으려 애쓰지만, 이는 마치 숨을 억지로 참는 것과 같아서 일정 시간 후 더욱 폭발적인 소리로 표출되어 극심한 수치심을 느끼게 됩니다.\n\n[신경해부학적 발병 메커니즘과 신경전달물질]\n신경생리학적으로 음성 틱은 호흡근과 발성 기관을 통제하는 중추신경계 회로의 탈억제(Disinhibition) 현상입니다. 대뇌 기저핵 내 선조체(Striatum)의 도파민 D2 수용체가 스트레스나 체질적 요인으로 인해 지나치게 민감해지면, 성대 근육을 자극하는 비정상적인 신경 스파이크 신호가 지속적으로 발생합니다. 여기에 정서적 공포와 불안을 관장하는 편도체(Amygdala)의 과각성이 더해지면 전두엽의 억제 제어 신호가 완전히 압도당하게 됩니다. 이로 인해 뇌가 '소리를 내어 답답한 긴장감을 분출하라'는 왜곡된 명령을 내리게 되는 신경생리학적 악순환이 고착화됩니다.\n\n[한의학적 원인 분석과 변증별 진료 방향]\n한의학 고전에서는 음성 틱을 담음(痰飮)이 기도를 막고 풍(風)이 상초로 치솟아 발생하는 담화상충(痰火上衝) 및 심신불교(心腎不交)의 관점에서 진단합니다. 체내 수액 대사가 원활하지 못해 생긴 끈적한 병리적 물질인 담음이 신경계를 자극하고, 화열(火熱)이 심장과 폐, 성대 주변으로 쏠리면서 소리가 불수의적으로 튀어나오는 것입니다. 진료 시에는 청열사화(淸熱瀉火)와 척담개규(滌痰開竅) 효능을 지닌 천마, 조구등, 반하, 석창포 등의 한약재를 정밀 배합하여 상초로 치솟는 열을 내리고 성대 주변 뇌신경의 과도한 긴장을 풀어줍니다. 이는 신경전달물질의 급격한 변동을 완화하여 도파민계의 안정을 도모합니다.\n\n[체계적인 치료 단계 및 생활 속 자가 관리 가이드]\n1단계: 학교 및 학원 지도교사와의 사전 소통. 아이가 일부러 소리를 내는 것이 아님을 알리고 수업 중 소리가 날 때 지적하거나 벌을 주지 않도록 비밀 보호 조치를 취합니다.\n2단계: 긴장 이완을 위한 호흡 발성 훈련. 목과 어깨, 흉부 근육이 경직되면 음성 틱이 악화되므로, 매일 복식호흡을 통해 횡격막을 이완시키고 따뜻한 온수를 수시로 섭취하여 인후부의 건조감과 이물감을 낮춰줍니다.\n3단계: 체계적인 두개골-경추 추나요법 병행. 뇌척수액의 순환 통로인 상부 경추(환추 및 축추)의 아탈구를 교정하여 뇌간 부위의 물리적 압박과 뇌신경 긴장도를 해소합니다."}, {"id": "col-auto-tic-3", "category": "틱장애", "title": "[성인 틱장애 극복] 직장 스트레스와 만성 신경 긴장에 따른 자율신경 조절 및 한의학 진료", "author": "해아림한의원", "date": "2026.09.25", "views": 175, "summary": "어린 시절의 틱이 잔존하거나 사회생활 스트레스로 성인기에 재발한 성인 틱장애의 특징, 직장 업무 압박에 따른 교감신경 항진 분석과 성인 맞춤형 뇌신경 안정 치료법을 다룹니다.", "content": "성인 틱장애는 소아기 틱 증상이 호전되지 않고 성인기까지 지속되거나, 과도한 직무 스트레스, 수면 박탈, 번아웃 등으로 인해 잠재되어 있던 신경학적 취약성이 재발하는 질환입니다. 성인은 사회적 시선 때문에 억지로 증상을 참으려 시도하지만, 이는 교감신경의 극심한 과각성과 목·어깨 근육의 만성 통증, 불안장애를 유발합니다. 성인 틱장애의 치료는 억압된 신경 긴장을 이완하고 자율신경계 균형을 복원하는 한의학적 맞춤 진료가 매우 효과적입니다.\n\n[환자들이 자주 묻는 질문과 임상 증상]\n\"어릴 때 눈 깜빡이던 게 다 나은 줄 알았는데, 취업 후 중요한 회의나 업무 압박이 심해지면 목을 꺾거나 헛기침이 다시 심해져요.\" 진료실을 찾는 20~40대 성인 틱 환자들의 주된 호소입니다. 성인은 아동과 달리 틱 증상을 숨기려는 '가면화(Camouflage)' 행동을 발달시킵니다. 목을 까딱이는 대신 스트레칭하는 척하거나, 헛기침 대신 기침 환자처럼 헛기침을 포장하려 애씁니다. 하지만 이러한 강박적 은폐 노력은 뇌의 주의 집중 자원을 고갈시켜 업무 효율 저하, 만성 만성 피로, 두통, 대인기피 증상으로 번지는 2차적 심리 합병증을 야기합니다.\n\n[신경해부학적 발병 메커니즘과 신경전달물질]\n신경생리학적으로 성인 틱장애는 만성 스트레스 호르몬인 코르티솔(Cortisol)의 과다 분비가 전두엽 피질의 시냅스 가소성을 저하시키면서 발생합니다. 지속적인 업무 중압감은 뇌의 공포·경보 시스템인 편도체를 과흥분시키고, 기저핵의 불필요한 운동 억제 회로를 무력화합니다. 이 과정에서 교감신경계가 과도하게 항진되어 혈관이 수축하고 후두하근과 승모근이 돌처럼 단단하게 굳어지며, 뇌로 가는 혈류량이 급감합니다. 결국 뇌세포의 산소 공급이 저하되면서 신경전달 신호의 오류가 잦아지고 틱 증상이 통제 불능 상태로 튀어나오게 됩니다.\n\n[한의학적 원인 분석과 변증별 진료 방향]\n한의학에서는 성인 틱장애의 주된 병기를 간기울결(肝氣鬱結)과 기체혈어(氣滯血瘀)로 규명합니다. 과도한 정신적 억압과 감정 노동으로 인해 간의 기운이 맺히고 소통되지 못하면 전신의 기혈 순환이 정체되며 신경망에 병리적인 열(熱)이 발생합니다. 임상에서는 시호, 작약, 향부자, 황련 등의 약재로 구성된 시호소간탕(柴胡疎肝湯)이나 분심기음(分心氣飮) 가감방을 적용하여 가슴에 맺힌 화기를 내리고 울체된 기혈을 풀어줍니다. 아울러 상체로 쏠린 기운을 하체로 끌어내리는 침구 치료와 약침 요법을 결합하여 교감신경의 과긴장을 누그러뜨리고 뇌신경계의 이완을 유도합니다.\n\n[체계적인 치료 단계 및 생활 속 자가 관리 가이드]\n1단계: 카페인과 알코올의 완전한 절제. 커피, 에너지 음료 등 고카페인은 중추신경을 직접 자극하여 틱 증상을 즉각 악화시키며, 알코올은 일시적 진정 후 반동성 뇌세포 흥분을 유발하므로 안정적으로 피해야 합니다.\n2단계: 점진적 근육 이완법(PMR)의 일상화. 틱이 자주 발생하는 목, 어깨 부위를 의도적으로 5초간 꽉 쥐었다가 10초간 힘을 완전히 빼는 훈련을 하루 3회 이상 시행하여 근막 긴장도를 낮춥니다.\n3단계: 충분한 수면 시간 확보. 성인의 경우 수면이 6시간 미만으로 떨어지면 전두엽 제어력이 급감하므로 최소 7시간의 양질의 수면을 보장해야 합니다.\n\n* 본 칼럼은 환자분들의 올바른 의학 정보 습득을 돕기 위해 작성되었으며, 개인의 체질과 증상에 따라 치료 반응과 예후는 차이가 있을 수 있으므로 전문 의료진과의 면밀한 상담을 권장합니다."}];
  var defaultBottomYoutube = [{"id": 1, "type": "long", "vid": "51rIQ1T5dIU", "title": "자율신경실조증이 있는 사람이 가급적 하면 안 되는 행동 3가지", "desc": "교감신경을 극도로 자극하는 카페인·자극적 음식, 불규칙한 야간 수면 패턴, 과도한 고강도 운동 등 자율신경실조증 환자가 일상에서 주의가 권장되는 핵심 행동 3가지.", "thumbnail": "https://i.ytimg.com/vi/51rIQ1T5dIU/hq720.jpg", "channel": "해아림TV 알쓸한상", "views": "조회수 17800회", "viewCount": 17800}, {"id": 2, "type": "shorts", "vid": "9X4PapgvBWE", "title": "자율신경실조증의 종류 ; 교감신경 항진, 교감신경 저하, 기립불내성", "desc": "교감신경 항진형, 부교감신경 저하형, 기립불내성(기립성 빈맥/어지럼) 등 자율신경실조증의 3대 아형(Subtypes) 분석과 맞춤 치료 전략.", "thumbnail": "https://i.ytimg.com/vi/9X4PapgvBWE/oardefault.jpg", "channel": "해아림TV 알쓸한상", "views": "조회수 15200회", "viewCount": 15200}, {"id": 3, "type": "long", "vid": "BpwXNE94k5k", "title": "병원 5곳 가도 원인을 모른다? 약 먹어도 안 낫는 자율신경실조증", "desc": "신체 검사상 이상이 없으나 가슴 두근거림, 호흡곤란, 어지럼증 등이 지속될 때 뇌-자율신경 조절 기능 저하를 진단하고 한방 치료를 적용하는 이유.", "thumbnail": "https://i.ytimg.com/vi/BpwXNE94k5k/hq720.jpg", "channel": "해아림TV 알쓸한상", "views": "조회수 16400회", "viewCount": 16400}];

  function getRealtimeBoardData(boardType) {
    try {
      if (boardType === 'faq') {
        var local = localStorage.getItem('healim_board_faqs');
        var delList = JSON.parse(localStorage.getItem('healim_deleted_faq_ids') || '[]');
        var list = local ? JSON.parse(local) : defaultBottomFaqs;
        return list.filter(function(it) { return delList.indexOf(String(it.id)) === -1; });
      } else if (boardType === 'reviews') {
        var local = localStorage.getItem('healim_board_reviews');
        return local ? JSON.parse(local) : defaultBottomReviews;
      } else if (boardType === 'columns') {
        var local = localStorage.getItem('healim_board_columns');
        var delList = JSON.parse(localStorage.getItem('healim_deleted_column_ids') || '[]');
        var list = local ? JSON.parse(local) : defaultBottomColumns;
        return list.filter(function(it) { return delList.indexOf(String(it.id)) === -1; });
      } else if (boardType === 'youtube') {
        var local = localStorage.getItem('healim_board_youtube');
        return local ? JSON.parse(local) : defaultBottomYoutube;
      }
    } catch(e) {}
    return [];
  }

  function extractYoutubeId(urlOrEmbed) {
    if (!urlOrEmbed) return '';
    var match = urlOrEmbed.match(/(?:embed\/|v=|youtu\.be\/|\/shorts\/)([a-zA-Z0-9_-]{11})/);
    return match ? match[1] : (urlOrEmbed.length === 11 ? urlOrEmbed : '');
  }

  // 모달 제어 함수
  window.openCommonBottomDetail = function(boardType, postId) {
    if (!boardType || postId === undefined || postId === null) return;
    var targetStrId = String(postId).trim();

    // 의료법 준수: 치료후기는 로그인 회원만 열람 가능
    if (boardType === 'reviews') {
      var rawUser = localStorage.getItem('healim_auth_user');
      var isAdmin = false;
      if (rawUser) {
        try {
          var u = JSON.parse(rawUser);
          if (u.role === 'admin' || u.uid === 'healim0071' || u.grade === 'superadmin') isAdmin = true;
        } catch(e) {}
      }
      if (!rawUser && !isAdmin) {
        var confirmLogin = confirm('치료후기는 환자의 개인정보 보호 및 의료법 제56조에 의거하여 로그인한 회원만 열람하실 수 있습니다.\n로그인 페이지로 이동하시겠습니까?');
        if (confirmLogin) {
          var backUrl = encodeURIComponent(window.location.pathname + '#reviews');
          window.location.href = '/login/?back_url=' + backUrl;
        }
        return;
      }
    }

    var list = getRealtimeBoardData(boardType);
    var item = list.find(function(it) {
      if (!it) return false;
      if (String(it.id) === targetStrId) return true;
      if (boardType === 'youtube' && (it.vid === targetStrId || extractYoutubeId(it.thumbnail || '') === targetStrId)) return true;
      return false;
    });

    if (!item) {
      window.location.href = '/community/?board=' + encodeURIComponent(boardType) + '&id=' + encodeURIComponent(postId);
      return;
    }

    var catEl = document.getElementById('commonBottomModalCategory');
    if (catEl) catEl.textContent = item.category || item.disease || (boardType === 'reviews' ? '치료후기' : (boardType === 'columns' ? '칼럼' : (boardType === 'youtube' ? '원장 특강' : 'FAQ')));

    var titleEl = document.getElementById('commonBottomModalTitle');
    if (titleEl) titleEl.textContent = item.title || item.q || '상세보기';

    var authorEl = document.getElementById('commonBottomModalAuthor');
    if (authorEl) authorEl.textContent = (item.author && item.author !== '익명') ? item.author : '해아림한의원';

    var dateEl = document.getElementById('commonBottomModalDate');
    if (dateEl) dateEl.textContent = item.date || '2026.09.28';

    var viewsEl = document.getElementById('commonBottomModalViews');
    if (viewsEl) {
      item.views = (parseInt(item.views, 10) || 0) + 1;
      viewsEl.textContent = item.views;
    }

    var ytArea = document.getElementById('commonBottomModalYoutubeArea');
    if (ytArea) {
      if (boardType === 'youtube') {
        var vId = item.vid || extractYoutubeId(item.thumbnail || targetStrId) || '51rIQ1T5dIU';
        ytArea.innerHTML = '<div style="position: relative; width: 100%; padding-top: 56.25%; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.3); border: 1px solid #2b8894;"><iframe style="position: absolute; inset: 0; width: 100%; height: 100%; border: none;" src="https://www.youtube.com/embed/' + vId + '?autoplay=1&rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>';
        ytArea.style.display = 'block';
      } else {
        ytArea.innerHTML = '';
        ytArea.style.display = 'none';
      }
    }

    var imgArea = document.getElementById('commonBottomModalImageArea');
    var imgEl = document.getElementById('commonBottomModalImage');
    var blurNotice = document.getElementById('commonBottomModalBlurNotice');
    if (imgArea && imgEl) {
      var imgSrc = item.img || item.image || '';
      if (imgSrc && boardType !== 'youtube') {
        imgEl.src = imgSrc;
        imgArea.style.display = 'block';
        if (blurNotice) blurNotice.style.display = (boardType === 'reviews') ? 'block' : 'none';
      } else {
        imgArea.style.display = 'none';
      }
    }

    var contentEl = document.getElementById('commonBottomModalContent');
    if (contentEl) {
      var bodyText = item.content || item.summary || item.a || item.desc || '';
      contentEl.innerHTML = bodyText.replace(/\n/g, '<br>');
    }

    var moreLink = document.getElementById('commonBottomModalMoreLink');
    if (moreLink) {
      moreLink.href = '/community/#' + boardType;
    }

    var modal = document.getElementById('commonBottomDetailModalBackdrop');
    if (modal) {
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeCommonBottomDetailModal = function() {
    var modal = document.getElementById('commonBottomDetailModalBackdrop');
    if (modal) {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      var ytArea = document.getElementById('commonBottomModalYoutubeArea');
      if (ytArea) ytArea.innerHTML = '';
    }
  };

  window.handleBottomMoreClick = function(e, boardType) {
    if (e && e.preventDefault) e.preventDefault();
    window.location.href = '/community/#' + boardType;
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCommonBottomDetailModal();
  });
})();
</script>